# PRODUCTION - Estas variáveis devem ser configuradas no Railway

NODE_ENV=production
PORT=3001

# Supabase - Railroad vai carregar automaticamente
# SUPABASE_URL=xxx
# SUPABASE_KEY=xxx
# DATABASE_URL=xxx

# JWT - MUDE ISSO EM PRODUÇÃO!
# JWT_SECRET=gere-uma-chave-aleatoria-segura

# Frontend
FRONTEND_URL=https://vendaspivot.com

# Logging
LOG_LEVEL=info

# Sentry (opcional)
# SENTRY_DSN=xxx
