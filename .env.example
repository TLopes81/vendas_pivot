# ============================================
# SUPABASE (PostgreSQL + Storage)
# ============================================

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=seu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=seu-service-role-key-aqui
SUPABASE_STORAGE_BUCKET=planilhas

# ============================================
# DATABASE (PostgreSQL)
# ============================================

DATABASE_URL=postgresql://postgres:sua-senha@seu-projeto.supabase.co:5432/postgres

# ============================================
# NODE
# ============================================

NODE_ENV=production
PORT=3001

# ============================================
# COPY THESE VALUES FROM SUPABASE
# ============================================

# Para pegar SUPABASE_URL:
# Settings → General → Project URL

# Para pegar SUPABASE_ANON_KEY:
# Settings → API → Project API keys → anon

# Para pegar SUPABASE_SERVICE_ROLE_KEY:
# Settings → API → Project API keys → service_role

# Para pegar DATABASE_URL:
# Settings → Database → Connection Info → URI (PostgreSQL)
