# ============================================
# SUPABASE (PostgreSQL + Storage)
# ============================================

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=seu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=seu-service-role-key-aqui
SUPABASE_STORAGE_BUCKET=planilhas

# ============================================
# DATABASE (PostgreSQL)
# ============================================

DATABASE_URL=postgresql://postgres:sua-senha@seu-projeto.supabase.co:5432/postgres

# ============================================
# JWT SEGURANÇA (GERE UMA CHAVE ALEATÓRIA!)
# ============================================

JWT_SECRET=gere-uma-chave-aleatoria-de-32-caracteres-aqui
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ============================================
# NODE
# ============================================

NODE_ENV=production
PORT=3001
FRONTEND_URL=https://vendaspivot.com

# ============================================
# SENTRY (Opcional - Error Tracking)
# ============================================

SENTRY_DSN=https://seu-sentry-dsn-aqui

# ============================================
# COMO GERAR JWT_SECRET SEGURO:
# ============================================

# No terminal, execute:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Copie o resultado e cole acima em JWT_SECRET

# ============================================
# ONDE PEGAR OS VALORES DO SUPABASE:
# ============================================

# SUPABASE_URL:
# Settings → General → Project URL

# SUPABASE_KEY:
# Settings → API → Project API keys → anon

# SUPABASE_SERVICE_ROLE_KEY:
# Settings → API → Project API keys → service_role

# DATABASE_URL:
# Settings → Database → Connection Info → URI (PostgreSQL)
